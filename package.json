    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.17",
    "jspdf": "^4.2.1",
