# =============================================================================
# Isabelle Wallet — configuração
# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# =============================================================================

# --- Backend --------------------------------------------------------------
# "local"    → banco PostgreSQL embutido (PGlite) em LOCAL_DATA_DIR + login local.
#              Ideal para rodar no seu computador sem nenhuma conta na nuvem.
# "supabase" → Supabase Auth + Postgres do Supabase (recomendado para publicar).
# Se vazio: usa Supabase quando as 3 variáveis do Supabase existem; senão, local.
DATA_BACKEND=

# --- Modo local -------------------------------------------------------------
LOCAL_DATA_DIR=.data/pglite
# Segredo para assinar a sessão (mín. 32 caracteres). Em desenvolvimento, se
# vazio, um segredo aleatório é gerado em .data/auth-secret. OBRIGATÓRIO em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Cadastro de novas contas:
#   vazio  → modo local: apenas o primeiro cadastro é permitido (app de uma pessoa só)
#            modo Supabase: permitido (desative em Supabase → Auth depois de criar a sua)
#   true   → sempre permitido
#   false  → sempre bloqueado
ALLOW_SIGNUP=

# --- Supabase ---------------------------------------------------------------
# Project Settings → API (URL e chave "publishable"/"anon" — são públicas por design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings → Database → Connection string → "Transaction pooler" (porta 6543).
# SECRETO: usado só no servidor; o app troca para o papel "authenticated" em cada
# transação, então o Row Level Security continua valendo.
DATABASE_URL=

# --- Câmbio -----------------------------------------------------------------
# "frankfurter" (padrão, taxas de referência do BCE, sem chave) ou "awesomeapi".
FX_PROVIDER=frankfurter
# Opcional: URL base alternativa do provedor.
FX_API_BASE_URL=

# --- IA (opcional) ------------------------------------------------------------
# Chave da API da Anthropic (console.anthropic.com). Sem chave, a Isabelle
# Intelligence funciona apenas com os cálculos locais. A chave fica só no servidor.
AI_API_KEY=
# Modelo (padrão: claude-opus-5-5)
AI_MODEL=
# Opcional: URL base alternativa da API
AI_BASE_URL=

# --- Next.js ------------------------------------------------------------------
# Para várias instâncias / self-hosting: chave estável para criptografar Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
