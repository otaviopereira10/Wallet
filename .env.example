# =============================================================================
# Isabelle Wallet — configuration
# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, add these in Project → Settings → Environment Variables instead.
# Step-by-step guide: docs/DEPLOY.md
# =============================================================================

# --- Backend --------------------------------------------------------------
# "local"    → embedded PostgreSQL (PGlite) in LOCAL_DATA_DIR + local login.
#              Great for running on your own computer with no cloud account.
# "supabase" → Supabase Auth + Supabase Postgres. REQUIRED on Vercel.
# If empty: Supabase is used when its 3 variables below are set; otherwise local.
DATA_BACKEND=

# --- Supabase ---------------------------------------------------------------
# Project Settings → API (URL and the "publishable"/"anon" key — public by design;
# the data is protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Connect → Connection string → "Transaction pooler" (port 6543), with your DB password.
# SECRET: used only on the server. The app switches to the "authenticated" role in
# every transaction, so Row Level Security still applies.
DATABASE_URL=
# Optional: the app's public address (e.g. https://isabelle-wallet.vercel.app),
# used in sign-up confirmation emails. On Vercel production it is detected automatically.
SITE_URL=

# Who can create an account:
#   empty → local mode: only the first sign-up is allowed (one-person app)
#           Supabase mode: allowed (turn it off in Supabase → Auth after creating yours)
#   true  → always allowed
#   false → always blocked
ALLOW_SIGNUP=

# --- Local mode only ------------------------------------------------------------
LOCAL_DATA_DIR=.data/pglite
# Secret used to sign the session (min. 32 characters). In development, if empty,
# a random one is generated in .data/auth-secret. REQUIRED for local mode in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Exchange rate ----------------------------------------------------------
# "frankfurter" (default, European Central Bank reference rates, no key) or "awesomeapi".
FX_PROVIDER=frankfurter
# Optional: alternative base URL for the provider.
FX_API_BASE_URL=

# --- AI (optional) ------------------------------------------------------------
# Anthropic API key (console.anthropic.com). Without it, Ask Isabelle works with the
# app's own calculations only. The key stays on the server.
AI_API_KEY=
# Model (default: claude-opus-5-5)
AI_MODEL=
# Optional: alternative API base URL
AI_BASE_URL=

# --- Next.js ------------------------------------------------------------------
# Only for self-hosting on several instances: a stable key to encrypt Server Actions.
# Not needed on Vercel.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
